<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12 o superior: pantalla de arranque del sistema solo con el gris del video (ícono transparente) de la app -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/fondo_intro</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/icono_vacio</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/fondo_intro</item>
    </style>
</resources>