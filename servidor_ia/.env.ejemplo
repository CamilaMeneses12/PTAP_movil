# Copie este archivo como .env y complete los valores. El .env NUNCA se sube al repositorio.

# --- Base de datos (docker-compose.yml) ---
DB_HOST=localhost
DB_PUERTO=5433
DB_NOMBRE=ptap_ia
DB_USUARIO=ptap_ia
DB_CLAVE=

# --- Usuarios ---
# Secreto con que la API firma los tokens. Genérelo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
JWT_SECRETO=
# Primer administrador (lo crea la semilla). Clave de 10+ caracteres con letras y números.
ADMIN_CORREO=admin@ptap.test
ADMIN_CLAVE=

# --- Modelo en la nube (con internet), formato OpenAI ---
NUBE_URL=https://api.groq.com/openai/v1
NUBE_KEY=
NUBE_MODELO=openai/gpt-oss-20b

# --- Modelo local del servidor (Ollama), respaldo si la nube falla ---
LOCAL_URL=http://localhost:11434/v1
LOCAL_MODELO=llama3.2

# --- API ---
PUERTO=3100
