{
  "name": "servidor-ia-ptap",
  "version": "1.0.0",
  "private": true,
  "description": "API del Asistente PTAP: PostgreSQL, usuarios, roles, chatbot (nube + local) y servidor MCP con permisos",
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "npm run build && node dist/main.js",
    "migracion:generar": "npm run build && typeorm migration:generate -d dist/base-datos/fuente.js",
    "migracion:correr": "npm run build && typeorm migration:run -d dist/base-datos/fuente.js",
    "migracion:revertir": "npm run build && typeorm migration:revert -d dist/base-datos/fuente.js",
    "semilla": "npm run build && node dist/base-datos/semilla.js",
    "pruebas:acceso": "node pruebas/acceso.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "@nestjs/common": "^12.6.0",
    "@nestjs/core": "^12.6.0",
    "@nestjs/jwt": "^12.0.5",
    "@nestjs/platform-express": "^12.6.0",
    "@nestjs/swagger": "^12.1.2",
    "@nestjs/throttler": "^6.8.0",
    "@nestjs/typeorm": "^12.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "helmet": "^8.3.0",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "typeorm": "^1.1.3",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.6",
    "typescript": "^6.0.3"
  }
}
